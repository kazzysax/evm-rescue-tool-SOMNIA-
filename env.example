# ============================================================
#  EVM RESCUE TOOL — Environment Config
#  Copy this file to .env and fill in your values
#  NEVER share your .env file or commit it to GitHub
# ============================================================

# Your compromised wallet private key (the one receiving the airdrop)
COMPROMISED_PRIVATE_KEY=0xYOUR_COMPROMISED_WALLET_PRIVATE_KEY

# A clean sponsor wallet private key — needs small ETH/native token for gas (~0.01)
SPONSOR_PRIVATE_KEY=0xYOUR_SPONSOR_WALLET_PRIVATE_KEY

# Your safe destination wallet address (where rescued assets will land)
SAFE_WALLET_ADDRESS=0xYOUR_SAFE_WALLET_ADDRESS

# ── RPC URL — pick your chain ────────────────────────────────────────────────
# Ethereum mainnet:  https://eth.llamarpc.com
# Arbitrum:         https://arb1.arbitrum.io/rpc
# Base:             https://mainnet.base.org
# Polygon:          https://polygon-rpc.com
# Optimism:         https://mainnet.optimism.io
# BNB Chain:        https://bsc-dataseed.binance.org
# Avalanche:        https://api.avax.network/ext/bc/C/rpc
# Somnia testnet:   https://dream-rpc.somnia.network
# Somnia mainnet:   https://vsomnia-rpc.somnia.network   (update when live)
RPC_URL=https://eth.llamarpc.com

# ── Token to rescue (optional) ───────────────────────────────────────────────
# ERC-20 token contract address of the airdrop
# Leave blank to sweep native ETH/gas token only
TOKEN_CONTRACT_ADDRESS=

# ── Block retry window (Flashbots mode only) ─────────────────────────────────
# How many blocks to keep retrying before giving up (default: 10)
MAX_BLOCKS=10
